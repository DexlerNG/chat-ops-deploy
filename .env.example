NODE_ENV=development
APP_NAME=chat-ops-deploy
DEBUG=app:debug
PORT=6000
LOG_OUT=1
TZ=Africa/Lagos

DEFAULT_CHAT_PROVIDER=slack
DEFAULT_REPO_PROVIDER=github
DEFAULT_CICD_PROVIDER=circleci
##Mongodb
MONGODB_URL=mongodb://127.0.0.1:27017
DATABASE_NAME=chat_ops_deploy

###Logs
LOG_LEVEL=debug

###Slack
SLACK_BASE_URL=https://slack.com
SLACK_TOKEN=xoxb-xxxxxxxxxxxxx


##Circle
CIRCLE_CI_TOKEN=XXXXXX
CIRCLE_CI_ORG=

##Github
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
GITHUB_OWNER=
GITHUB_WORKFLOW_ID=deploy.yml
GITHUB_API_VERSION=2022-11-28


# Slack-only release boundary; populate the registry only for commissioned targets.
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_ID=
SLACK_DEPLOY_CHANNEL_ID=
GITHUB_WEBHOOK_SECRET=
SLACK_RELEASE_TARGETS_JSON={}
GITHUB_RELEASE_BOT_LOGIN=
SMOKE_CICD_PROVIDER=circleci

# Comma-separated services switched to PR-driven release and Slack notifications.
PR_DELIVERY_SERVICES=
